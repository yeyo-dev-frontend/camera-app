{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "REACT_NATIVE_ARCHITECTURES": "arm64-v8a",
        "CMAKE_BUILD_PARALLEL_LEVEL": "2",
        "CMAKE_COMPILE_JOBS": "2",
        "GRADLE_MAX_WORKERS": "1",
        "GRADLE_OPTS": "-Dorg.gradle.jvmargs=\"-XX:MaxMetaspaceSize=512m -Xmx2560m -Dfile.encoding=UTF-8\" -Dorg.gradle.parallel=false -Dorg.gradle.workers.max=1 -Dorg.gradle.daemon=false"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "REACT_NATIVE_ARCHITECTURES": "arm64-v8a",
        "CMAKE_BUILD_PARALLEL_LEVEL": "2",
        "CMAKE_COMPILE_JOBS": "2",
        "GRADLE_MAX_WORKERS": "1",
        "GRADLE_OPTS": "-Dorg.gradle.jvmargs=\"-XX:MaxMetaspaceSize=512m -Xmx2560m -Dfile.encoding=UTF-8\" -Dorg.gradle.parallel=false -Dorg.gradle.workers.max=1 -Dorg.gradle.daemon=false"
      }
    }
  }
}
